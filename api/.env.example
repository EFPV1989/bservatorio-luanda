# Copiar para .env (desenvolvimento) e .env.test (testes). Nunca versionar segredos reais.
TZ=UTC
NODE_ENV=development
PORT=3333
HOST=localhost
APP_NAME=observatorio-luanda-api
LOG_LEVEL=info
# Gerar com: node ace generate:key
APP_KEY=

# PostGIS do docker-compose.yml (na raiz do repositório)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=observatorio
DB_PASSWORD=observatorio_dev
DB_DATABASE=observatorio_dev
DB_POOL_MAX=10

# Lista separada por vírgulas; vazio = nenhuma origem cross-site em produção, todas em dev
CORS_ORIGINS=

# Lado (m) dos hexágonos servidos pela API; tem de existir na tabela grelha_hexagonos
GRELHA_LADO_M=500
