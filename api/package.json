{
  "name": "observatorio-luanda-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "node ace test",
    "test:unit": "node ace test unit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#modules/*": "./app/modules/*.js",
    "#shared/*": "./app/shared/*.js",
    "#database/*": "./database/*.js",
    "#start/*": "./start/*.js",
    "#tests/*": "./tests/*.js",
    "#config/*": "./config/*.js"
  },
  "prettier": "@adonisjs/prettier-config",
  "hotHook": {
    "boundaries": [
      "./app/**/*_controller.ts",
      "./app/middleware/*.ts"
    ]
  },
  "dependencies": {
    "@adonisjs/core": "^6.21.0",
    "@adonisjs/cors": "^2.2.1",
    "@adonisjs/lucid": "^21.8.2",
    "@vinejs/vine": "^3.0.1",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.8.2",
    "@adonisjs/eslint-config": "^2.1.2",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^1.4.1",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "^4.0.0",
    "@japa/runner": "^4.5.0",
    "@swc/core": "^1.10.1",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "hot-hook": "^1.0.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "ts-node-maintained": "^10.9.6",
    "typescript": "~5.8"
  }
}
